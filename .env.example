# Configuración de DESARROLLO LOCAL para docker-compose.dev.yml:
#   cp .env.example .env.dev      (npm run stack:up del front lo hace solo si falta)
# Todas las credenciales son de ejemplo, solo para uso local. No uses estos
# valores fuera de tu máquina.
#
# Para ejecutar con `go run` en el host (BD en Docker), cambia POSTGRES_HOST a
# localhost y publica el puerto de la BD.

APP_PORT=8080
# Puertos publicados en el host: API en 18080, Adminer en 18081.
API_HOST_PORT=18080
ADMINER_HOST_PORT=18081

# config.go lee POSTGRES_* (no DB_*). El contenedor de Postgres usa estas mismas
# variables para crear el usuario y la base la primera vez (volumen vacío).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=kali_auth
POSTGRES_PASSWORD=kali_auth_local_only
POSTGRES_DB=kali_auth_dev
POSTGRES_SSLMODE=disable

LOG_LEVEL=debug

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# El emisor de access tokens firma con RS256 usando un par de claves RSA local
# (internal/infrastructure/security/jwt_access_token_issuer.go). Sin
# JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH el proceso no arranca.
# docker-compose.dev.yml las genera solo (servicio jwt-keys) en .secrets/
# (ignorado por git) si no existen; nunca sobrescribe unas existentes.
# Fuera de Docker: `make jwt-keys-dev`.
# JWT_ISSUER es un identificador lógico del emisor (claim "iss"), no una URL de red:
# debe ser EXACTAMENTE igual a JWT_ISSUER de kali-invoice-service (valor unificado
# http://localhost:8080). JWT_AUDIENCE también debe coincidir (account).
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=account
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_PRIVATE_KEY_PATH=.secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt_public.pem
# Opcional; si se deja vacío el issuer usa "main-key" (kid) por defecto.
JWT_KEY_ID=

# Usuario y empresa de plataforma creados al arrancar (idempotente: si ya existen
# no se modifican). Con ellos se inicia sesión la primera vez y se crean las
# demás empresas. Contraseña de EJEMPLO, solo local.
SEED_MASTER_ENABLED=true
SEED_MASTER_TENANT_ID=master-tenant
SEED_MASTER_TENANT_NAME=Master Tenant
# Código legible de la empresa maestra (tenant de plataforma).
SEED_MASTER_TENANT_CODE=master
SEED_MASTER_USER_ID=master-user
SEED_MASTER_IDENTIFICATION_NUMBER=1000000000
SEED_MASTER_USERNAME=master
SEED_MASTER_EMAIL=master@local.dev
SEED_MASTER_PASSWORD=Kali#Local2026
# Alternativa: ruta a un archivo con la contraseña (tiene prioridad si se define).
SEED_MASTER_PASSWORD_FILE=
