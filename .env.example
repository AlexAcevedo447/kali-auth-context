APP_PORT=8080
API_HOST_PORT=18080
ADMINER_HOST_PORT=18081

# config.go lee POSTGRES_* (no DB_*).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=kali_auth_dev
POSTGRES_SSLMODE=disable

LOG_LEVEL=debug

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# El emisor de access tokens firma con RS256 usando un par de claves RSA local
# (internal/infrastructure/security/jwt_access_token_issuer.go). Sin
# JWT_PRIVATE_KEY_PATH/JWT_PUBLIC_KEY_PATH el proceso no arranca. Generar el
# par de desarrollo con `make jwt-keys-dev` (crea .secrets/jwt_*.pem, ignorado
# por git) y apuntar aquí a esos archivos.
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=account
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_PRIVATE_KEY_PATH=.secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt_public.pem
# Opcional; si se deja vacío el issuer usa "main-key" (kid) por defecto.
JWT_KEY_ID=

# Bootstrap master user seed
SEED_MASTER_ENABLED=false
SEED_MASTER_TENANT_ID=master-tenant
SEED_MASTER_TENANT_NAME=Master Tenant
SEED_MASTER_USER_ID=master-user
SEED_MASTER_IDENTIFICATION_NUMBER=1000000000
SEED_MASTER_USERNAME=master
SEED_MASTER_EMAIL=master@local.dev
SEED_MASTER_PASSWORD=
SEED_MASTER_PASSWORD_FILE=
